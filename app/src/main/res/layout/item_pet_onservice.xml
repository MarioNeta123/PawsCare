<?xml version="1.0" encoding="utf-8"?>

<!-- Tarjeta de item -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_pet_onservice"
    android:layout_width="365dp"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/bg_rounded"
    android:backgroundTint="@color/light_blue">

    <!-- Imagen -->
    <ImageView
        android:id="@+id/iv_pet_photo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_circle_white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Contenedor de textos -->
    <LinearLayout
        android:id="@+id/text_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="@id/iv_pet_photo"
        app:layout_constraintStart_toEndOf="@id/iv_pet_photo"
        app:layout_constraintEnd_toStartOf="@id/tv_status">

        <TextView
            android:id="@+id/tv_pet_spa_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pet_spa_title"
            android:textSize="14sp"
            android:textColor="@color/dark_blue"
            android:textStyle="bold"
            android:fontFamily="@font/kanit" />

        <TextView
            android:id="@+id/tv_service_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/service_type_label"
            android:textSize="11sp"
            android:textColor="@color/dark_blue"
            android:fontFamily="@font/kanit" />

    </LinearLayout>

    <!-- Badge de estado -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center"
        android:background="@drawable/bg_rounded"
        android:backgroundTint="@color/extra_light_green"
        android:text="@string/status"
        android:textSize="13sp"
        android:textColor="@color/light_green"
        android:textStyle="bold"
        android:fontFamily="@font/kanit"
        app:layout_constraintTop_toTopOf="@id/iv_pet_photo"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barrier: se ajusta al elemento más alto de la fila (imagen, textos o badge) -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iv_pet_photo,text_group,tv_status" />

    <!-- Sección condicional -->
    <LinearLayout
        android:id="@+id/group_service_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/barrier_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Fila -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_progress_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/drying_progress_label"
                android:textSize="14sp"
                android:textColor="@color/dark_blue"
                android:textStyle="bold"
                android:fontFamily="@font/kanit" />

            <TextView
                android:id="@+id/tv_progress_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/progress_percentage"
                android:textSize="14sp"
                android:textColor="@color/dark_blue"
                android:textStyle="bold"
                android:fontFamily="@font/kanit" />

        </LinearLayout>

        <!-- Barra -->
        <ProgressBar
            android:id="@+id/progress_drying"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/bg_progress_bar_green" />

        <!-- Texto -->
        <TextView
            android:id="@+id/tv_ready_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/pet_onbath_message"
            android:textSize="11sp"
            android:textColor="@color/dark_blue"
            android:textStyle="bold"
            android:fontFamily="@font/kanit" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>