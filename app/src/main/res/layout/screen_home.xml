<?xml version="1.0" encoding="utf-8"?>

<!-- Pantalla de inicio (home): saludo, mascotas, estado de vacunación y alertas -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:ignore="VisualLintSystemUi">

    <!-- Contenido superior desplazable: encabezado, saludo, mascotas, estado de vacunación y título de alertas -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/top_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Organiza los elementos de forma vertical -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Encabezado del home -->
            <include
                layout="@layout/component_header" />

            <!-- Bloque de saludo y selector de mascotas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <!-- Agrupa el saludo y el mensaje de la mascota -->
                <LinearLayout
                    android:id="@+id/text_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Saludo al usuario -->
                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/greeting"
                        android:textSize="16sp"
                        android:textColor="@color/gray"
                        android:fontFamily="@font/kanit" />

                    <!-- Mensaje destacado relacionado con la mascota -->
                    <TextView
                        android:id="@+id/tv_pet_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pet_message"
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:fontFamily="@font/kanit" />

                </LinearLayout>

                <!-- Selector horizontal de mascotas del usuario -->
                <HorizontalScrollView
                    android:id="@+id/scroll_pets_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <!-- Contenedor de las mascotas registradas -->
                    <LinearLayout
                        android:id="@+id/layout_pets_placeholder"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- Tarjeta individual de mascota (foto, nombre, raza) -->
                        <include
                            android:id="@+id/pet"
                            layout="@layout/item_pet" />

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

            <!-- Tarjeta con el estado de vacunación de la mascota seleccionada -->
            <include
                android:id="@+id/pet_vc_state"
                layout="@layout/item_vaccination_card_state" />

            <!-- Encabezado de la sección de alertas (dentro del scroll superior) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="10dp">

                <!-- Título de la sección de alertas -->
                <TextView
                    android:id="@+id/tv_alertas_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/alerts_view"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:fontFamily="@font/kanit" />

                <!-- Acceso directo para ver todas las alertas -->
                <TextView
                    android:id="@+id/tv_ver_todo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/all_view"
                    android:textSize="14sp"
                    android:textColor="@color/dark_blue"
                    android:textStyle="bold"
                    android:fontFamily="@font/kanit" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Área desplazable con el listado de alertas del home -->
    <ScrollView
        android:id="@+id/warnings_feed"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/top_scroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation">

        <!-- Contenedor de tarjetas de alerta -->
        <LinearLayout
            android:id="@+id/layout_alerts_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Tarjeta individual de alerta -->
            <include
                android:id="@+id/alert"
                layout="@layout/item_default_a" />

        </LinearLayout>

    </ScrollView>

    <!-- Barra de navegación inferior de la app -->
    <include
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        layout="@layout/component_bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>